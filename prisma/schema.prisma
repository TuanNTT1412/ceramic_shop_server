// 1. Hồ sơ yêu cầu trả hàng
model ReturnRequest {
  id                    String                 @id @default(uuid())
  returnCode            String                 @unique // VD: "RET-20261028-001"
  
  orderId               String
  order                 Order                  @relation(fields: [orderId], references: [id])
  
  customerId            String
  customer              User                   @relation(fields: [customerId], references: [id])
  
  orderDetailId         String
  orderDetail           OrderDetail            @relation(fields: [orderDetailId], references: [id])
  
  reason                ReturnReason
  customerNote          String?                @db.Text
  status                ReturnStatus           @default(DRAFT_INSPECTING)
  
  // Ghi vết kiểm toán khi nhân viên duyệt
  reviewedBy            String?                // ID của Staff/Admin duyệt
  reviewedAt            DateTime?              // Thời điểm duyệt
  adminNote             String?   @db.Text     // Ghi chú duyệt hoặc lý do từ chối
  
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Quan hệ 1-1 với các thực thể con
  aiInspection          AiInspection?
  refund                Refund?
  // warehouseVerification WarehouseVerification?
}

// 2. Giám định AI ban đầu (Sinh ra khi khách quét QR & chụp ảnh xong)
model AiInspection {
  id                    String        @id @default(uuid())
  returnRequestId       String        @unique
  returnRequest         ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  
  captureSessionId      String?
  capturedImages        Json?         // { truoc: "url", sau: "url", trai: "url", phai: "url" }
  
  aiDetectedDamage      Boolean       @default(false)
  aiDamageScore         Float         @default(0.0) // 0.0 -> 1.0 (VD: 0.85 = 85%)
  aiDefectType          String?       // "CRACK_NECK", "CHIP_RIM"...
  estimatedRefundAmount Int           @default(0)   // Số tiền AI đề xuất (VNĐ)
  
  customerAgreedWithAi  Boolean       // true = Khách đồng ý nộp ticket, false = Không đồng ý
  customerRejectReason  String?       @db.Text
  defectDetails         Json?         // Chi tiết các khuyết tật (tọa độ bbox, diện tích, confidence)
  resultImages          Json?         // Ảnh kết quả khoanh vùng lỗi (_result.jpg)
  
  inspectedAt           DateTime      @default(now())
}

