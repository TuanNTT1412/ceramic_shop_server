// 4. Giao dịch hoàn tiền (Sinh ra khi nhân viên bấm APPROVED - Ghi vết dòng tiền âm)
model Refund {
  id                    String        @id @default(uuid())
  returnRequestId       String        @unique
  returnRequest         ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  
  refundAmount          Int           // Số tiền thực tế shop hoàn trả
  adminNote             String?       @db.Text // Ghi chú hoàn tiền
  performedBy           String        // ID admin/staff duyệt hoàn
  createdAt             DateTime      @default(now()) // Thời điểm ghi nhận dòng tiền âm
}

