generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. NGƯỜI DÙNG & TÀI KHOẢN
// ==========================================
enum Role {
  CUSTOMER // Đã đổi từ USER thành CUSTOMER theo chuẩn Use Case
  ADMIN
  STAFF
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(CUSTOMER)
  avatar        String?
  isActive      Boolean        @default(true) // true = Đang hoạt động, false = Bị khóa
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  refreshTokens RefreshToken[]
  addresses     UserAddress[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  returnRequests ReturnRequest[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserAddress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiverName  String
  receiverPhone String
  addressDetail String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// 2. SẢN PHẨM & DANH MỤC
// ==========================================
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id          String    @id @default(uuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean   @default(true) // true = Đang bán, false = Ẩn
  isReturnable Boolean  @default(false) // true = Hỗ trợ trả hàng & AI, false = Không áp dụng đổi trả
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants     ProductVariant[]
  orderDetails OrderDetail[]
  reviews      Review[]
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName   String    // VD: "Men rạn - Size L" hoặc "Mặc định"
  price         Int
  stockQuantity Int       @default(0)

  images       VariantImage[]
  orderDetails OrderDetail[]
  cartItems     CartItem[]
}

model VariantImage {
  id           String         @id @default(uuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageUrl     String
  isPrimary    Boolean        @default(false)
  displayOrder Int            @default(0)
}

// ==========================================
// 3. ĐƠN HÀNG (ORDER & PAYMENT)
// ==========================================
enum DeliveryType {
  PICKUP
  SHIPPING
}

enum PaymentMethod {
  COD
  PAYOS
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPING
  READY_FOR_PICKUP
  COMPLETED
  CANCELED
}

enum ShippingProvider {
  GHTK
  VTP
  VNPOST
  AHAMOVE
}

model Order {
  id               String            @id @default(uuid())
  orderCode        String            @unique
  customerId       String
  customer         User              @relation(fields: [customerId], references: [id])
  
  // Snapshot thông tin nhận hàng
  receiverName     String
  receiverPhone    String
  deliveryType     DeliveryType
  deliveryAddress  String?           // Null nếu là PICKUP
  
  // Thông tin tiền tệ
  shippingFee      Int               @default(0)
  totalAmount      Int
  
  // Thanh toán & Trạng thái
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus     @default(UNPAID)
  orderStatus      OrderStatus       @default(PENDING)
  
  // Vận chuyển (Nhân viên thao tác)
  shippingProvider ShippingProvider? // Null nếu là PICKUP
  trackingCode     String?           // Mã bill nhân viên nhập tay
  cancelReason     String?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  shippedAt        DateTime?         // Thời điểm bàn giao bưu tá xuất kho
  completedAt      DateTime?         // Thời điểm giao thành công hoặc khách nhận tại quầy
  canceledAt       DateTime?         // Thời điểm hủy đơn

  orderDetails     OrderDetail[]
  returnRequests ReturnRequest[]
}

model OrderDetail {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Liên kết về bảng Sản phẩm (Khóa lại, không cho phép xóa vĩnh viễn sản phẩm/phân loại nếu đã có đơn)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  
  // Dữ liệu Snapshot (Lưu cứng lúc mua để chống thay đổi từ master data)
  productName    String
  classification String?
  unitPrice      Int
  quantity       Int
  subTotal       Int

  review         Review?
  returnRequests ReturnRequest[]
}

// ==========================================
// 4. GIỎ HÀNG (CART)
// ==========================================
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique // Đảm bảo quan hệ 1-1: Mỗi user 1 giỏ hàng
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cartItems CartItem[]
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // ĐỀ XUẤT THÊM: Chống trùng lặp sản phẩm trong cùng 1 giỏ hàng
  @@unique([cartId, variantId]) 
}

// ==========================================
// 5. ĐÁNH GIÁ SẢN PHẨM (REVIEW)
// ==========================================
model Review {
  id            String      @id @default(uuid())

  userId        String
  user          User        @relation(fields: [userId], references: [id])

  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderDetailId String      @unique
  orderDetail   OrderDetail @relation(fields: [orderDetailId], references: [id])

  rating        Int
  comment       String?     @db.Text
  images        String[]
  adminReply    String?     @db.Text
  replyAt       DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==========================================
// 6. QUẢN LÝ TRẢ HÀNG & KIỂM ĐỊNH (RETURN & INSPECTION)
// ==========================================

enum ReturnStatus {
  DRAFT_INSPECTING       // Khách đang quét QR chụp ảnh & AI tính toán
  CANCELLED_BY_CUSTOMER  // Khách xem mức AI xong bấm Không đồng ý (Dừng lại)
  TICKET_SUBMITTED       // Khách Đồng ý -> Đã nộp ticket cho shop
  APPROVED               // Nhân viên duyệt chấp thuận hoàn tiền
  REJECTED               // Nhân viên từ chối yêu cầu
//   WAITING_FOR_PICKUP     // Chờ shipper qua lấy hàng
//   WAREHOUSE_INSPECTING   // Hàng về kho, nhân viên đang kiểm tra thực tế
//   RETURNING_TO_CUSTOMER  // Khách không chịu kết quả kho -> Shop gửi trả bình lại cho khách
//   ITEM_RETURNED_TO_CUSTOMER // Khách đã nhận lại bình -> Đóng ticket
//   AWAITING_REFUND        // Đạt kiểm định kho, chờ shop chuyển tiền
//   COMPLETED              // Đã chuyển tiền & upload bill thành công
//   REJECTED               // Shop từ chối thẳng
}

enum ReturnReason {
  DAMAGED_IN_TRANSIT     // Vỡ/nứt khi nhận hàng
  DEFECTIVE_PRODUCT      // Lỗi men, nứt lò nung
  WRONG_ITEM             // Shop giao sai mẫu
  NOT_AS_DESCRIBED       // Không đúng mô tả
  OTHER                  // Lý do khác
}

